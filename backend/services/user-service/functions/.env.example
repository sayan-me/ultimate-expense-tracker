# Copy to .env.<firebase-project-id> (e.g. .env.uet-stg) and fill in real
# values. Firebase CLI uploads this automatically as the deployed
# function's environment on `firebase deploy` / `npm run deploy` — this is
# more reliable than editing env vars by hand in the Cloud Run/GCP console,
# which a later CLI deploy can silently overwrite.
#
# SUPABASE_SERVICE_ROLE_KEY must be the service_role ("secret") key from
# Supabase (Project Settings -> API), NOT the anon/public key — the new
# Phase 4 sync tables have RLS policies that only allow service_role, so
# the anon key cannot read or write them. Never put this key in any
# NEXT_PUBLIC_* var or client-side code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
GOOGLE_API_KEY=your_firebase_web_api_key_here
